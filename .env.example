# Webhook (n8n / Make / serverless fn). Must be HTTPS and allow this site's origin via CORS.
# Never put Airtable tokens here: the webhook layer talks to Airtable, not the browser.
VITE_LEAD_WEBHOOK_URL=
# Meta Pixel ID (public by design). Leave empty to disable browser-side tracking.
VITE_META_PIXEL_ID=
